[core]
    autocrlf = input
    safecrlf = true
	pager = delta

[init]
    defaultBranch = main

[push]
    default = simple
    autoSetupRemote = true

[pull]
    rebase = false

[color "status"]
    added = cyan
    changed = yellow
    untracked = white
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
[merge]
	conflictStyle = zdiff3
